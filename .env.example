# Prihlasovacie údaje k XTB demo účtu (xAPI).
#
# Skopíruj tento súbor ako .env a doplň vlastné hodnoty:
#     cp .env.example .env
#
# Súbor .env je v .gitignore a nikdy sa necommituje.

# Číslo XTB demo účtu (dostaneš ho e-mailom pri založení demo účtu)
XTB_USER_ID=

# Heslo k XTB demo účtu
XTB_PASSWORD=
